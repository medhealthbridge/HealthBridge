# Better Auth — https://www.better-auth.com/docs/installation
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database (Neon Postgres) — use the DIRECT (non-pooled) connection string
# for drizzle-kit generate/migrate; the app's runtime client can use either,
# but direct is simplest while RLS session variables (SET LOCAL) are in play.
# The app connects with this. In production it must be the restricted `clinix_app` role (docs/db-app-role.md):
# a role that cannot bypass row-level security, so the tenant policies are actually enforced.
DATABASE_URL=
# Owner connection, for migrations and seed scripts only. Never set this in the deployed app.
DATABASE_ADMIN_URL=

# Social sign-in (optional). A provider's button only shows on /clinix-ph/auth
# when both of its values are set. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Transactional email (verification links) via Resend — https://resend.com/docs
# Required: sign-up can't complete without it. For local testing, Resend's
# onboarding@resend.dev sender delivers to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM="Clinix PH <no-reply@clinix.ph>"
# Secret Vercel Cron sends to /api/cron/reminders (any long random string). Without it the daily reminder job refuses to run.
CRON_SECRET=

# Where the DataBridgeSol landing's "Clinix PH" buttons point. Set in
# production (https://clinix.databridgesol.space); leave unset locally so
# they open this server's /clinix-ph instead of the live site.
NEXT_PUBLIC_CLINIX_URL=

# --- Own-domain checkout at the end of onboarding (all optional) -------------
# The step appears only when the registrar AND at least one payment provider
# below are configured. DataBridgeSol is the registrant of every domain sold.
# Vercel token must belong to the team that owns this project (it is billed
# for each domain); needs a Pro team. Domains attach to VERCEL_PROJECT_ID.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# JSON: {"firstName":"…","lastName":"…","email":"…","phone":"+63.9171234567","address1":"…","city":"…","state":"…","zip":"…","country":"PH","companyName":"DataBridgeSol"}
DOMAIN_REGISTRANT=
# Registrar prices are USD; clients are charged PHP = USD x rate x (1 + margin).
USD_PHP_RATE=60
DOMAIN_MARGIN=0.1
# PayMongo: webhook URL <site>/api/webhooks/paymongo, event checkout_session.payment.paid
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Xendit: invoice-paid callback URL <site>/api/webhooks/xendit, verification token below
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Company-admin assistant, three layers: instant rules (no key, free) -> Gemini -> Claude.
# Each key is optional; add them in Vercel (never in chat or the repo). With none set,
# the assistant answers only its rule-based questions.
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ADMIN_AGENT_MODEL=
# AI answers per person per day before it falls back to the free rules.
AGENT_DAILY_AI_LIMIT=100
